# Copy to .env for local development.

DATABASE_URL=postgresql://dealflow:dealflow@localhost:5432/dealflow
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Optional GitHub sign-in. Leave both empty to hide the button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# OpenAI-compatible drafting. Leave AI_API_KEY empty to keep drafting off.
# OpenRouter, Groq, and Ollama all work through AI_BASE_URL. Ollama accepts any non-empty key.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional Telegram bot token. Each workspace stores its own chat id.
TELEGRAM_BOT_TOKEN=

# Protects POST /api/jobs/overdue. Leave empty to keep that route closed.
CRON_SECRET=
